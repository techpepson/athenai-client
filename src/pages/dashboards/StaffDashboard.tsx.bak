/**
 * StaffDashboard Component
 *
 * Displays attendance statistics for the logged-in staff member.
 * All data is fetched from the backend API.
 */

import { useState, useMemo, useEffect, useCallback } from "react";
import {
  BarChart3,
  Users,
  TrendingUp,
  Calendar,
  CheckCircle2,
  Clock,
  CalendarX2,
  Loader2,
  RefreshCw,
  UserX,
  Award,
} from "lucide-react";
import { StatCard } from "@/components/dashboard/StatCard";
import { AttendanceChart } from "@/components/dashboard/AttendanceChart";
import {
  EarlyArrivalsCard,
} from "@/components/dashboard/EarlyArrivalsCard";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { useAuth } from "@/contexts/AuthContext";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import {
  getUserAttendance,
  AttendanceRecord,
} from "@/services/attendance.services";
import { AttendanceStatus } from "@/enums/enums";

/* helpers */

const getDayName = (date: Date): string => {
  const days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
  return days[date.getDay()];
};

const StaffDashboard = () => {
  const { user, token } = useAuth();
  const [loading, setLoading] = useState(true);
  const [attendanceRecords, setAttendanceRecords] = useState<
    AttendanceRecord[]
  >([]);
  const [selectedMonth, setSelectedMonth] = useState<string>("all");

  /* data fetch */
  const loadData = useCallback(async () => {
    if (!token) {
      setLoading(false);
      return;
    }
    setLoading(true);
    try {
      const res = await getUserAttendance(token);
      if (res.success && res.data) {
        setAttendanceRecords(res.data);
      } else {
        setAttendanceRecords([]);
      }
    } catch (err) {
      console.error("Failed to load staff attendance:", err);
      setAttendanceRecords([]);
    } finally {
      setLoading(false);
    }
  }, [token]);

  useEffect(() => {
    loadData();
  }, [loadData]);

  /* dynamic months from actual records */
  const availableMonths = useMemo(() => {
    const monthSet = new Map<string, string>();
    attendanceRecords.forEach((r) => {
      const d = new Date(r.checkInTime || r.timestamp || "");
      if (isNaN(d.getTime())) return;
      const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
      if (!monthSet.has(key)) {
        monthSet.set(
          key,
          d.toLocaleDateString("en-US", { month: "long", year: "numeric" }),
        );
      }
    });
    return Array.from(monthSet.entries())
      .sort(([a], [b]) => b.localeCompare(a))
      .map(([value, label]) => ({ value, label }));
  }, [attendanceRecords]);

  /* filter by month */
  const filteredRecords = useMemo(() => {
    if (selectedMonth === "all") return attendanceRecords;
    return attendanceRecords.filter((r) => {
      const d = new Date(r.checkInTime || r.timestamp || "");
      if (isNaN(d.getTime())) return false;
      const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
      return key === selectedMonth;
    });
  }, [attendanceRecords, selectedMonth]);

  /* stats */
  const stats = useMemo(() => {
    let present = 0;
    let late = 0;
    let absent = 0;
    let checkedIn = 0;

    filteredRecords.forEach((r) => {
      switch (r.status) {
        case AttendanceStatus.PRESENT:
          present++;
          break;
        case AttendanceStatus.LATE:
          late++;
          break;
        case AttendanceStatus.ABSENT:
          absent++;
          break;
        case AttendanceStatus.CHECKED_IN:
          checkedIn++;
          break;
      }
    });

    const total = present + late + absent + checkedIn;
    const rate = total > 0 ? Math.round(((present + late) / total) * 100) : 0;

    return { present, late, absent, checkedIn, total, rate };
  }, [filteredRecords]);

  /* weekly chart data - last 7 days from all records (not filtered by month) */
  const weeklyChartData = useMemo(() => {
    const today = new Date();
    const days: { day: string; present: number; late: number }[] = [];
    for (let i = 6; i >= 0; i--) {
      const d = new Date(today);
      d.setDate(today.getDate() - i);
      d.setHours(0, 0, 0, 0);
      const dayKey = d.toISOString().split("T")[0];
      let present = 0;
      let late = 0;
      attendanceRecords.forEach((r) => {
        const rDate = new Date(r.checkInTime || r.timestamp || "");
        if (rDate.toISOString().split("T")[0] === dayKey) {
          if (r.status === AttendanceStatus.PRESENT) present++;
          else if (r.status === AttendanceStatus.LATE) late++;
        }
      });
      days.push({ day: getDayName(d), present, late });
    }
    return days;
  }, [attendanceRecords]);

  /* daily trend for selected month */
  const dailyTrend = useMemo(() => {
    const trend: { date: string; present: number; total: number }[] = [];
    const grouped: Record<string, { present: number; total: number }> = {};

    filteredRecords.forEach((r) => {
      const d = new Date(r.checkInTime || r.timestamp || "");
      if (isNaN(d.getTime())) return;
      const dayKey = d.toISOString().split("T")[0];
      if (!grouped[dayKey]) grouped[dayKey] = { present: 0, total: 0 };
      grouped[dayKey].total++;
      if (
        r.status === AttendanceStatus.PRESENT ||
        r.status === AttendanceStatus.LATE
      ) {
        grouped[dayKey].present++;
      }
    });

    Object.entries(grouped)
      .sort(([a], [b]) => b.localeCompare(a))
      .forEach(([date, data]) => trend.push({ date, ...data }));

    return trend;
  }, [filteredRecords]);

  /* session type breakdown */
  const sessionBreakdown = useMemo(() => {
    const breakdown: Record<string, number> = {};
    filteredRecords.forEach((r) => {
      const type = r.session?.status || "Unknown";
      breakdown[type] = (breakdown[type] || 0) + 1;
    });
    return breakdown;
  }, [filteredRecords]);

  /* early arrivals (sessions where staff checked in before session start) */
  const earlyArrivals = useMemo(() => {
    return filteredRecords
      .filter((r) => {
        if (!r.checkInTime || !r.session?.startTime) return false;
        const checkIn = new Date(r.checkInTime);
        const sessionStart = new Date(r.session.startTime);
        return checkIn < sessionStart;
      })
      .sort((a, b) => {
        const aEarly =
          new Date(a.session!.startTime!).getTime() -
          new Date(a.checkInTime!).getTime();
        const bEarly =
          new Date(b.session!.startTime!).getTime() -
          new Date(b.checkInTime!).getTime();
        return bEarly - aEarly;
      })
      .slice(0, 5)
      .map((r) => ({
        id: r.id,
        memberId: user?.id || "",
        memberName: user?.name || "Staff",
        photoUrl: user?.profilePicture || undefined,
        department: r.session?.course?.title || r.session?.name || "Session",
        checkInTime: new Date(r.checkInTime!),
        scheduledTime: new Date(r.session!.startTime!),
        minutesEarly: Math.round(
          (new Date(r.session!.startTime!).getTime() -
            new Date(r.checkInTime!).getTime()) /
            60000,
        ),
      }));
  }, [filteredRecords, user]);

  const firstName = user?.name.split(" ")[0] || "Staff";

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[400px]">
        <div className="flex flex-col items-center gap-4">
          <Loader2 className="w-8 h-8 animate-spin text-primary" />
          <p className="text-muted-foreground">Loading your dashboard...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-4 sm:space-y-6 animate-fade-in">
      {/* Page Header */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-xl sm:text-2xl font-bold text-foreground">
            My Attendance Stats
          </h1>
          <p className="text-sm sm:text-base text-muted-foreground mt-1">
            Welcome back {firstName}! Here&rsquo;s your attendance overview.
          </p>
          <p className="text-xs sm:text-sm text-muted-foreground mt-1">
            Staff ID: {user?.staff?.staffNo || "N/A"}
          </p>
        </div>
        <button
          onClick={loadData}
          disabled={loading}
          className="p-2 rounded-lg hover:bg-muted transition-colors"
          title="Refresh data"
        >
          <RefreshCw
            className={`w-4 h-4 text-muted-foreground ${loading ? "animate-spin" : ""}`}
          />
        </button>
      </div>

      {/* Month Filter */}
      <div className="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
        <label className="text-sm font-medium">Filter by Month:</label>
        <Select value={selectedMonth} onValueChange={setSelectedMonth}>
          <SelectTrigger className="w-full sm:w-64">
            <SelectValue placeholder="Select a month" />
          </SelectTrigger>
          <SelectContent>
            <SelectItem value="all">All Time</SelectItem>
            {availableMonths.map((m) => (
              <SelectItem key={m.value} value={m.value}>
                {m.label}
              </SelectItem>
            ))}
          </SelectContent>
        </Select>
      </div>

      {/* Stats Grid */}
      <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 sm:gap-3 md:gap-4">
        <StatCard
          title="Total Sessions"
          value={stats.total}
          icon={Calendar}
          variant="primary"
        />
        <StatCard
          title="Present"
          value={stats.present}
          icon={CheckCircle2}
          variant="success"
        />
        <StatCard
          title="Late"
          value={stats.late}
          icon={Clock}
          variant="warning"
        />
        <StatCard
          title="Absent"
          value={stats.absent}
          icon={UserX}
          variant="destructive"
        />
        <StatCard
          title="Members"
          value={stats.total}
          icon={Users}
          variant="default"
        />
        <StatCard
          title="Attendance Rate"
          value={`${stats.rate}%`}
          icon={TrendingUp}
          trend={
            stats.total > 0
              ? { value: stats.rate, isPositive: stats.rate >= 70 }
              : undefined
          }
        />
      </div>

      {/* Main Content Grid */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
        {/* Weekly Chart */}
        <div className="lg:col-span-2 bg-card rounded-lg sm:rounded-xl border border-border p-4 sm:p-6">
          <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-0 mb-4 sm:mb-6">
            <div>
              <h2 className="text-base sm:text-lg font-semibold text-foreground">
                Weekly Attendance
              </h2>
              <p className="text-xs sm:text-sm text-muted-foreground">
                Your attendance for the last 7 days
              </p>
            </div>
            {weeklyChartData.some((d) => d.present > 0 || d.late > 0) && (
              <div className="flex items-center gap-3 sm:gap-4 text-xs sm:text-sm">
                <div className="flex items-center gap-1.5 sm:gap-2">
                  <div className="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-primary" />
                  <span className="text-muted-foreground">Present</span>
                </div>
                <div className="flex items-center gap-1.5 sm:gap-2">
                  <div className="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-warning" />
                  <span className="text-muted-foreground">Late</span>
                </div>
              </div>
            )}
          </div>
          {weeklyChartData.some((d) => d.present > 0 || d.late > 0) ? (
            <AttendanceChart data={weeklyChartData} />
          ) : (
            <div className="flex flex-col items-center justify-center py-12 text-center">
              <BarChart3 className="w-12 h-12 text-muted-foreground/50 mb-4" />
              <h3 className="text-base font-medium text-foreground mb-2">
                No attendance data yet
              </h3>
              <p className="text-sm text-muted-foreground max-w-sm">
                Your attendance chart will appear here once you start attending
                sessions.
              </p>
            </div>
          )}
        </div>

        {/* Session Breakdown */}
        <Card>
          <CardHeader className="p-4 sm:p-6">
            <CardTitle className="flex items-center gap-2 text-base sm:text-lg">
              <BarChart3 className="w-4 h-4 sm:w-5 sm:h-5" />
              Session Breakdown
            </CardTitle>
          </CardHeader>
          <CardContent className="p-4 sm:p-6 pt-0 sm:pt-0">
            <div className="space-y-2 sm:space-y-3">
              {Object.entries(sessionBreakdown).length > 0 ? (
                Object.entries(sessionBreakdown).map(([type, count]) => (
                  <div
                    key={type}
                    className="flex items-center justify-between p-2 rounded-lg bg-muted/50"
                  >
                    <span className="text-sm font-medium capitalize">
                      {type.toLowerCase().replace(/_/g, " ")}
                    </span>
                    <Badge variant="outline">{count}</Badge>
                  </div>
                ))
              ) : (
                <p className="text-sm text-muted-foreground text-center py-4">
                  No session data available
                </p>
              )}
            </div>
          </CardContent>
        </Card>
      </div>

      {/* Daily Attendance Overview */}
      <Card>
        <CardHeader className="p-4 sm:p-6">
          <CardTitle className="flex items-center gap-2 text-base sm:text-lg">
            <Clock className="w-4 h-4 sm:w-5 sm:h-5" />
            Daily Attendance Overview
          </CardTitle>
        </CardHeader>
        <CardContent className="p-4 sm:p-6 pt-0 sm:pt-0">
          <div className="space-y-2 max-h-72 sm:max-h-96 overflow-y-auto">
            {dailyTrend.length > 0 ? (
              dailyTrend.map(({ date, present, total }) => {
                const rate =
                  total > 0 ? Math.round((present / total) * 100) : 0;
                return (
                  <div
                    key={date}
                    className="p-3 rounded-lg border border-border flex items-center justify-between"
                  >
                    <div>
                      <p className="text-sm font-medium">
                        {new Date(date).toLocaleDateString("en-US", {
                          weekday: "short",
                          month: "short",
                          day: "numeric",
                        })}
                      </p>
                      <p className="text-xs text-muted-foreground">
                        {present} / {total} present
                      </p>
                    </div>
                    <Badge
                      variant={rate >= 80 ? "default" : "secondary"}
                      className="ml-2"
                    >
                      {rate}%
                    </Badge>
                  </div>
                );
              })
            ) : (
              <p className="text-sm text-muted-foreground text-center py-8">
                No attendance data for this period
              </p>
            )}
          </div>
        </CardContent>
      </Card>

      {/* Early Arrivals */}
      {earlyArrivals.length > 0 ? (
        <EarlyArrivalsCard arrivals={earlyArrivals} />
      ) : (
        <div className="bg-card rounded-lg sm:rounded-xl border border-border p-6">
          <div className="flex items-center justify-between mb-4">
            <div>
              <h2 className="text-base sm:text-lg font-semibold text-foreground">
                Early Arrivals
              </h2>
              <p className="text-xs sm:text-sm text-muted-foreground">
                Sessions where you arrived before the scheduled time
              </p>
            </div>
            <Award className="w-5 h-5 text-muted-foreground" />
          </div>
          <div className="flex flex-col items-center justify-center py-8 text-center">
            <Award className="w-12 h-12 text-muted-foreground/50 mb-4" />
            <h3 className="text-base font-medium text-foreground mb-2">
              No early arrivals yet
            </h3>
            <p className="text-sm text-muted-foreground max-w-sm">
              Your early arrival records will appear here once you start
              checking in ahead of scheduled times.
            </p>
          </div>
        </div>
      )}

      {/* Empty State for no records at all */}
      {attendanceRecords.length === 0 && (
        <Card className="border-dashed">
          <CardContent className="flex flex-col items-center justify-center py-12 text-center">
            <CalendarX2 className="w-12 h-12 text-muted-foreground/50 mb-4" />
            <h3 className="text-lg font-medium text-muted-foreground mb-2">
              No Attendance Records
            </h3>
            <p className="text-sm text-muted-foreground max-w-sm">
              Your attendance history will appear here once you start attending
              sessions.
            </p>
          </CardContent>
        </Card>
      )}
    </div>
  );
};

export default StaffDashboard;
